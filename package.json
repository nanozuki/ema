{
  "name": "exodus-media-awards",
  "version": "1.0.0",
  "description": "Exodus Media Awards",
  "author": "Nanozuki Crows",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanozuki/crows.moe.git"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:integration && npm run test:unit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest",
    "migration:generate": "drizzle-kit generate",
    "migration:local": "pnpx wrangler d1 migrations apply ema --local",
    "migration:prod": "pnpx wrangler d1 migrations apply ema --remote"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "1.2.56",
    "@iconify-json/mdi": "^1.2.3",
    "@playwright/test": "1.58.2",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/adapter-cloudflare": "7.2.8",
    "@sveltejs/kit": "2.52.2",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/postcss": "4.2.0",
    "@types/node": "25.3.0",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "drizzle-kit": "0.31.9",
    "eslint": "10.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.15.0",
    "postcss": "8.5.6",
    "prettier": "3.8.1",
    "prettier-plugin-svelte": "3.5.0",
    "svelte": "5.53.0",
    "svelte-check": "4.4.1",
    "tailwindcss": "4.2.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-svelte-plugin": "0.3.50",
    "unplugin-icons": "23.0.1",
    "vite": "7.3.1",
    "vitest": "4.0.18",
    "wrangler": "4.67.0"
  },
  "type": "module",
  "dependencies": {
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.1",
    "jose": "6.1.3",
    "melt": "^0.44.0",
    "runed": "^0.37.1",
    "ts-pattern": "5.9.0",
    "zod": "4.3.6"
  },
  "packageManager": "pnpm@10.30.0"
}
